# Supabase project URL and server-only service-role key. Never use NEXT_PUBLIC_ for secrets.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: openssl rand -hex 32
GATEWAY_SECRET=
# Required on Vercel / production. Used to sign into the dashboard.
DASHBOARD_PASSWORD=
# Only enable when running behind a proxy that overwrites x-forwarded-for.
# Vercel is detected automatically; leave false for local development.
TRUST_PROXY=false
# Optional AI analyst. Keep this server-only; the core gateway works without it.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
